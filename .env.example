# Configurazione di tModManager in Docker (letta da docker-compose.yml).
# L'installer crea questo file da solo: a mano basta copiarlo in .env e riempire i valori vuoti.

# --- Sito ---------------------------------------------------------------------------------------
# Indirizzo pubblico del pannello
APP_URL=https://tmm.example.com
# Dove ascolta Caddy dentro il container:
#   un dominio (es. tmm.example.com) → HTTPS automatico con Let's Encrypt (porte 80 e 443 libere)
#   :80                              → solo HTTP (senza dominio, oppure dietro un altro proxy)
TMM_SITE_ADDRESS=tmm.example.com
# Porte sull'host. Dietro un proxy esistente (Apache/nginx): TMM_HTTP_BIND=127.0.0.1:8080
TMM_HTTP_BIND=80
TMM_HTTPS_BIND=443
# Dietro un proxy: TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12 e SESSION_SECURE_COOKIE=true se il proxy è in HTTPS
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=true

# --- Server di gioco ----------------------------------------------------------------------------
# Porte pubblicate per i server Terraria (una per server)
TMM_GAME_PORTS=7777-7787
# Chiave Steam Web API (facoltativa): versioni delle mod e ricerca nel Workshop
STEAM_API_KEY=

# --- Immagini ----------------------------------------------------------------------------------
# registry = scarica le immagini già pronte (GitHub Actions → ghcr.io); build = le costruisce qui
TMM_IMAGES=registry
TMM_IMAGE_REGISTRY=ghcr.io/jtgabry
# latest = ultima versione di main; oppure una versione (es. 1.2) o un commit (sha-abc1234)
TMM_IMAGE_TAG=latest

# --- Dati e utente ------------------------------------------------------------------------------
# Cartella con tutti i dati (server, mod, tModLoader, database)
TMM_DATA_PATH=./data
# UID/GID del proprietario di TMM_DATA_PATH sull'host (id -u / id -g): i file restano suoi
TMM_UID=1000
TMM_GID=1000

# --- Segreti (generati dall'installer) ------------------------------------------------------------
# php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"  oppure  openssl rand -base64 32 (con prefisso base64:)
APP_KEY=
# openssl rand -hex 32
AGENT_TOKEN=
