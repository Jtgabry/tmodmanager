APP_NAME=tModManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://tmm.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cartella dati unica (condivisa con l'agent): relativa alla radice del progetto oppure assoluta
TMM_DATA_DIR=data

# SQLite: il database è <TMM_DATA_DIR>/database.sqlite (DB_SQLITE_DATABASE per cambiarlo)
DB_CONNECTION=sqlite
# In alternativa MariaDB/MySQL (anche come origine di "php artisan db:import-from mariadb"):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tmodmanager
# DB_USERNAME=tmodmanager
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Domini della SPA che ricevono la sessione (di default quello di APP_URL; in sviluppo aggiungi localhost:5173)
# SANCTUM_STATEFUL_DOMAINS=tmm.example.com,localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Agent (demone che gestisce processi e file dei server)
AGENT_URL=http://127.0.0.1:7878
AGENT_TOKEN=
