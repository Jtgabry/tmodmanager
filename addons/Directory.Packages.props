<!-- Versioni dei pacchetti degli add-on. L'API dei plugin (ApiVersion 2.1) è la stessa per tutta TShock 6. -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="TShock" Version="6.2.1" />
    <!-- Terraria (via OTAPI) per tools/MapColors: la stessa versione che usa TShock 6.2.1 -->
    <PackageVersion Include="OTAPI.Upcoming" Version="3.3.14" />
  </ItemGroup>
</Project>
