<!--
  Strumenti di build (non add-on): girano durante la compilazione per ricavare dati da Terraria.
  Non ereditano ../Directory.Build.props: qui servono le .dll di Terraria anche a runtime.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
</Project>
