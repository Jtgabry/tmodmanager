AGENT_HOST=127.0.0.1
AGENT_PORT=7878
# Deve coincidere con AGENT_TOKEN in backend/.env
AGENT_TOKEN=

# Cartella dati unica (condivisa con Laravel): relativa alla radice del progetto oppure assoluta
TMM_DATA_DIR=data

# Facoltative: sorgenti delle versioni di TShock e del runtime .NET che gli serve
# AGENT_TSHOCK_REPOSITORY=Pryaxis/TShock
# AGENT_DOTNET_RELEASES=https://builds.dotnet.microsoft.com/dotnet/release-metadata

# Solo in Docker: allo spegnimento dell'agent salva e spegne i server, al riavvio li riaccende
# AGENT_STOP_SERVERS_ON_EXIT=1
