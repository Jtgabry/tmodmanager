# tModManager — Caddy (FrankenPHP)
#
# /                   → SPA React (frontend/dist), con fallback su index.html per React Router
# /api, /sanctum, /up → Laravel
# /ws/                → agent, solo la console WebSocket (autenticata da un ticket di Laravel)
#
# TMM_SITE_ADDRESS: un dominio (es. tmm.example.com) → HTTPS automatico con Let's Encrypt;
# ":80" → solo HTTP (dietro un altro proxy, o senza dominio).
{
	frankenphp
	admin off
	{$CADDY_GLOBAL_OPTIONS}
}

{$TMM_SITE_ADDRESS::80} {
	encode zstd gzip

	handle /ws/* {
		reverse_proxy {$AGENT_UPSTREAM:agent:7878}
	}

	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		root * /app/backend/public
		php_server
	}

	handle {
		root * /app/frontend/dist

		# Gli asset di Vite hanno l'hash nel nome; il resto (index.html, sw.js, manifest) va
		# sempre ricontrollato, altrimenti le nuove versioni non arrivano alle app installate
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	log {
		output stderr
		format console
	}
}
